// Rime Frost: Frost-white paper under the same cold accents, deepened to read on it.
// https://github.com/w0x7y/rime
themes {
    rime-frost {
        text_unselected {
            base "#363d4a"
            background "#f7f8fa"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        text_selected {
            base "#272d37"
            background "#d2d8e2"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        ribbon_unselected {
            base "#363d4a"
            background "#d2d8e2"
            emphasis_0 "#866405"
            emphasis_1 "#e3e7ee"
            emphasis_2 "#2e62c0"
            emphasis_3 "#b83d63"
        }
        ribbon_selected {
            base "#eef1f5"
            background "#2e62c0"
            emphasis_0 "#f7f8fa"
            emphasis_1 "#f7f8fa"
            emphasis_2 "#f7f8fa"
            emphasis_3 "#f7f8fa"
        }
        table_title {
            base "#2e62c0"
            background "#eef1f5"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        table_cell_unselected {
            base "#363d4a"
            background "#eef1f5"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        table_cell_selected {
            base "#272d37"
            background "#d2d8e2"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        list_unselected {
            base "#363d4a"
            background "#eef1f5"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        list_selected {
            base "#272d37"
            background "#d2d8e2"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        frame_unselected {
            base "#7f899b"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        frame_selected {
            base "#2e62c0"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        frame_highlight {
            base "#866405"
            emphasis_0 "#7650c4"
            emphasis_1 "#866405"
            emphasis_2 "#866405"
            emphasis_3 "#866405"
        }
        exit_code_success {
            base "#267b4f"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        exit_code_error {
            base "#b83d63"
            emphasis_0 "#866405"
            emphasis_1 "#0f7480"
            emphasis_2 "#267b4f"
            emphasis_3 "#7650c4"
        }
        multiplayer_user_colors {
            player_1 "#7650c4"
            player_2 "#2e62c0"
            player_3 "#267b4f"
            player_4 "#866405"
            player_5 "#0f7480"
            player_6 "#a34396"
            player_7 "#b83d63"
            player_8 "#5f7090"
            player_9 "#566073"
            player_10 "#272d37"
        }
    }
}
