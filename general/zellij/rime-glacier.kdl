// Rime Glacier: Crisper accents with clear separation between every syntax role, on a lighter background.
// https://github.com/w0x7y/rime
themes {
    rime-glacier {
        text_unselected {
            base "#c5cedd"
            background "#22272d"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        text_selected {
            base "#dfe5ee"
            background "#414854"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        ribbon_unselected {
            base "#c5cedd"
            background "#414854"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#323841"
            emphasis_2 "#6eaaf0"
            emphasis_3 "#e07a90"
        }
        ribbon_selected {
            base "#2a2f37"
            background "#6eaaf0"
            emphasis_0 "#22272d"
            emphasis_1 "#22272d"
            emphasis_2 "#22272d"
            emphasis_3 "#22272d"
        }
        table_title {
            base "#6eaaf0"
            background "#2a2f37"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        table_cell_unselected {
            base "#c5cedd"
            background "#2a2f37"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        table_cell_selected {
            base "#dfe5ee"
            background "#414854"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        list_unselected {
            base "#c5cedd"
            background "#2a2f37"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        list_selected {
            base "#dfe5ee"
            background "#414854"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        frame_unselected {
            base "#737e94"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        frame_selected {
            base "#6eaaf0"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        frame_highlight {
            base "#e3dc9e"
            emphasis_0 "#ae94f0"
            emphasis_1 "#e3dc9e"
            emphasis_2 "#e3dc9e"
            emphasis_3 "#e3dc9e"
        }
        exit_code_success {
            base "#88d8a0"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        exit_code_error {
            base "#e07a90"
            emphasis_0 "#e3dc9e"
            emphasis_1 "#6fd0d8"
            emphasis_2 "#88d8a0"
            emphasis_3 "#ae94f0"
        }
        multiplayer_user_colors {
            player_1 "#ae94f0"
            player_2 "#6eaaf0"
            player_3 "#88d8a0"
            player_4 "#e3dc9e"
            player_5 "#6fd0d8"
            player_6 "#f2a7e0"
            player_7 "#e07a90"
            player_8 "#788bb0"
            player_9 "#9aa4b6"
            player_10 "#dfe5ee"
        }
    }
}
