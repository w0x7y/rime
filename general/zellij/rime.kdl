// Rime: Soft and muted pastels for long sessions.
// https://github.com/w0x7y/rime
themes {
    rime {
        text_unselected {
            base "#c3ccd9"
            background "#1d2026"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        text_selected {
            base "#dce2eb"
            background "#3a404b"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        ribbon_unselected {
            base "#c3ccd9"
            background "#3a404b"
            emphasis_0 "#e4d098"
            emphasis_1 "#2b3038"
            emphasis_2 "#7aa4e4"
            emphasis_3 "#d98a9c"
        }
        ribbon_selected {
            base "#23272e"
            background "#7aa4e4"
            emphasis_0 "#1d2026"
            emphasis_1 "#1d2026"
            emphasis_2 "#1d2026"
            emphasis_3 "#1d2026"
        }
        table_title {
            base "#7aa4e4"
            background "#23272e"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        table_cell_unselected {
            base "#c3ccd9"
            background "#23272e"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        table_cell_selected {
            base "#dce2eb"
            background "#3a404b"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        list_unselected {
            base "#c3ccd9"
            background "#23272e"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        list_selected {
            base "#dce2eb"
            background "#3a404b"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        frame_unselected {
            base "#6b768c"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        frame_selected {
            base "#7aa4e4"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        frame_highlight {
            base "#e4d098"
            emphasis_0 "#bb98d6"
            emphasis_1 "#e4d098"
            emphasis_2 "#e4d098"
            emphasis_3 "#e4d098"
        }
        exit_code_success {
            base "#9ad8ac"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        exit_code_error {
            base "#d98a9c"
            emphasis_0 "#e4d098"
            emphasis_1 "#7cc4d0"
            emphasis_2 "#9ad8ac"
            emphasis_3 "#bb98d6"
        }
        multiplayer_user_colors {
            player_1 "#bb98d6"
            player_2 "#7aa4e4"
            player_3 "#9ad8ac"
            player_4 "#e4d098"
            player_5 "#7cc4d0"
            player_6 "#e8a8cc"
            player_7 "#d98a9c"
            player_8 "#7987a1"
            player_9 "#9aa4b6"
            player_10 "#dce2eb"
        }
    }
}
