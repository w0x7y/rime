// Rime Abyss: The coldest take, on a darker background: no yellow or orange anywhere, with rose as the only warm accent.
// https://github.com/w0x7y/rime
themes {
    rime-abyss {
        text_unselected {
            base "#c2cde0"
            background "#111317"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        text_selected {
            base "#dde5f2"
            background "#2c3039"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        ribbon_unselected {
            base "#c2cde0"
            background "#2c3039"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#1d2026"
            emphasis_2 "#6b9cf4"
            emphasis_3 "#e8879f"
        }
        ribbon_selected {
            base "#15171c"
            background "#6b9cf4"
            emphasis_0 "#111317"
            emphasis_1 "#111317"
            emphasis_2 "#111317"
            emphasis_3 "#111317"
        }
        table_title {
            base "#6b9cf4"
            background "#15171c"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        table_cell_unselected {
            base "#c2cde0"
            background "#15171c"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        table_cell_selected {
            base "#dde5f2"
            background "#2c3039"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        list_unselected {
            base "#c2cde0"
            background "#15171c"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        list_selected {
            base "#dde5f2"
            background "#2c3039"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        frame_unselected {
            base "#6b768c"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        frame_selected {
            base "#6b9cf4"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        frame_highlight {
            base "#9cf0dc"
            emphasis_0 "#937ff2"
            emphasis_1 "#9cf0dc"
            emphasis_2 "#9cf0dc"
            emphasis_3 "#9cf0dc"
        }
        exit_code_success {
            base "#6fd0a8"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        exit_code_error {
            base "#e8879f"
            emphasis_0 "#9cf0dc"
            emphasis_1 "#4fb4dc"
            emphasis_2 "#6fd0a8"
            emphasis_3 "#937ff2"
        }
        multiplayer_user_colors {
            player_1 "#937ff2"
            player_2 "#6b9cf4"
            player_3 "#6fd0a8"
            player_4 "#9cf0dc"
            player_5 "#4fb4dc"
            player_6 "#d4aaff"
            player_7 "#e8879f"
            player_8 "#7182a8"
            player_9 "#9aa4b6"
            player_10 "#dde5f2"
        }
    }
}
