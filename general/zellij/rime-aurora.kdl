// Rime Aurora: Vivid neon accents on a darker background.
// https://github.com/w0x7y/rime
themes {
    rime-aurora {
        text_unselected {
            base "#c8d2e2"
            background "#17191e"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        text_selected {
            base "#e0e7f2"
            background "#333842"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        ribbon_unselected {
            base "#c8d2e2"
            background "#333842"
            emphasis_0 "#e6f07c"
            emphasis_1 "#24282f"
            emphasis_2 "#4fa2ff"
            emphasis_3 "#ff6f91"
        }
        ribbon_selected {
            base "#1c1f25"
            background "#4fa2ff"
            emphasis_0 "#17191e"
            emphasis_1 "#17191e"
            emphasis_2 "#17191e"
            emphasis_3 "#17191e"
        }
        table_title {
            base "#4fa2ff"
            background "#1c1f25"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        table_cell_unselected {
            base "#c8d2e2"
            background "#1c1f25"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        table_cell_selected {
            base "#e0e7f2"
            background "#333842"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        list_unselected {
            base "#c8d2e2"
            background "#1c1f25"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        list_selected {
            base "#e0e7f2"
            background "#333842"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        frame_unselected {
            base "#6b768c"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        frame_selected {
            base "#4fa2ff"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        frame_highlight {
            base "#e6f07c"
            emphasis_0 "#9b7dff"
            emphasis_1 "#e6f07c"
            emphasis_2 "#e6f07c"
            emphasis_3 "#e6f07c"
        }
        exit_code_success {
            base "#5ef0a6"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        exit_code_error {
            base "#ff6f91"
            emphasis_0 "#e6f07c"
            emphasis_1 "#38dce8"
            emphasis_2 "#5ef0a6"
            emphasis_3 "#9b7dff"
        }
        multiplayer_user_colors {
            player_1 "#9b7dff"
            player_2 "#4fa2ff"
            player_3 "#5ef0a6"
            player_4 "#e6f07c"
            player_5 "#38dce8"
            player_6 "#ff8fe0"
            player_7 "#ff6f91"
            player_8 "#7084b7"
            player_9 "#9aa4b6"
            player_10 "#e0e7f2"
        }
    }
}
