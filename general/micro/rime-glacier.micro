# Rime Glacier: Crisper accents with clear separation between every syntax role, on a lighter background.
# https://github.com/w0x7y/rime
color-link default "#c5cedd,#2a2f37"
color-link comment "italic #737e94"
color-link identifier "#6eaaf0"
color-link identifier.class "#6eaaf0"
color-link identifier.macro "#6fd0d8"
color-link identifier.var "#c5cedd"
color-link constant "#f2a7e0"
color-link constant.bool "#f2a7e0"
color-link constant.number "#f2a7e0"
color-link constant.specialChar "#6fd0d8"
color-link constant.string "#88d8a0"
color-link constant.string.url "underline #6eaaf0"
color-link statement "#ae94f0"
color-link symbol "#9aa4b6"
color-link symbol.operator "#9aa4b6"
color-link symbol.brackets "#788bb0"
color-link symbol.tag "#e07a90"
color-link preproc "#e3dc9e"
color-link type "#e3dc9e"
color-link type.keyword "#ae94f0"
color-link special "#6fd0d8"
color-link underlined "underline "
color-link error "#e07a90"
color-link todo "bold #2a2f37,#e3dc9e"
color-link ignore "#737e94"
color-link selection ",#414854"
color-link statusline "#9aa4b6,#323841"
color-link statusline.inactive "#737e94,#323841"
color-link statusline.suggestions "#c5cedd,#323841"
color-link tabbar "#737e94,#323841"
color-link tabbar.active "bold #dfe5ee,#2a2f37"
color-link indent-char "#525a6a"
color-link line-number "#737e94,#2a2f37"
color-link current-line-number "bold #dfe5ee,#2a2f37"
color-link cursor-line ",#323841"
color-link color-column ",#2e343c"
color-link gutter-info "#6eaaf0"
color-link gutter-error "#e07a90"
color-link gutter-warning "#e3dc9e"
color-link diff-added "#88d8a0"
color-link diff-modified "#6eaaf0"
color-link diff-deleted "#e07a90"
color-link scrollbar "#737e94"
color-link divider "#3a404b,#2a2f37"
color-link message "#c5cedd"
color-link error-message "#e07a90"
color-link match-brace "bold #dfe5ee,#414854"
color-link hlsearch "#dfe5ee,#5e5f54"
color-link tab-error ",#453a44"
color-link trailingws ",#453a44"
