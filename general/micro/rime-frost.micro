# Rime Frost: Frost-white paper under the same cold accents, deepened to read on it.
# https://github.com/w0x7y/rime
color-link default "#363d4a,#eef1f5"
color-link comment "italic #7f899b"
color-link identifier "#2e62c0"
color-link identifier.class "#2e62c0"
color-link identifier.macro "#0f7480"
color-link identifier.var "#363d4a"
color-link constant "#a34396"
color-link constant.bool "#a34396"
color-link constant.number "#a34396"
color-link constant.specialChar "#0f7480"
color-link constant.string "#267b4f"
color-link constant.string.url "underline #2e62c0"
color-link statement "#7650c4"
color-link symbol "#566073"
color-link symbol.operator "#566073"
color-link symbol.brackets "#5f7090"
color-link symbol.tag "#b83d63"
color-link preproc "#866405"
color-link type "#866405"
color-link type.keyword "#7650c4"
color-link special "#0f7480"
color-link underlined "underline "
color-link error "#b83d63"
color-link todo "bold #eef1f5,#866405"
color-link ignore "#7f899b"
color-link selection ",#d2d8e2"
color-link statusline "#566073,#e3e7ee"
color-link statusline.inactive "#7f899b,#e3e7ee"
color-link statusline.suggestions "#363d4a,#e3e7ee"
color-link tabbar "#7f899b,#e3e7ee"
color-link tabbar.active "bold #272d37,#eef1f5"
color-link indent-char "#b1b8c4"
color-link line-number "#7f899b,#eef1f5"
color-link current-line-number "bold #272d37,#eef1f5"
color-link cursor-line ",#e3e7ee"
color-link color-column ",#e9ecf2"
color-link gutter-info "#2e62c0"
color-link gutter-error "#b83d63"
color-link gutter-warning "#866405"
color-link diff-added "#267b4f"
color-link diff-modified "#2e62c0"
color-link diff-deleted "#b83d63"
color-link scrollbar "#7f899b"
color-link divider "#dbe0e8,#eef1f5"
color-link message "#363d4a"
color-link error-message "#b83d63"
color-link match-brace "bold #272d37,#d2d8e2"
color-link hlsearch "#272d37,#d1cab2"
color-link tab-error ",#e6d6df"
color-link trailingws ",#e6d6df"
