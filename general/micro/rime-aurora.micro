# Rime Aurora: Vivid neon accents on a darker background.
# https://github.com/w0x7y/rime
color-link default "#c8d2e2,#1c1f25"
color-link comment "italic #6b768c"
color-link identifier "#4fa2ff"
color-link identifier.class "#4fa2ff"
color-link identifier.macro "#38dce8"
color-link identifier.var "#c8d2e2"
color-link constant "#ff8fe0"
color-link constant.bool "#ff8fe0"
color-link constant.number "#ff8fe0"
color-link constant.specialChar "#38dce8"
color-link constant.string "#5ef0a6"
color-link constant.string.url "underline #4fa2ff"
color-link statement "#9b7dff"
color-link symbol "#9aa4b6"
color-link symbol.operator "#9aa4b6"
color-link symbol.brackets "#7084b7"
color-link symbol.tag "#ff6f91"
color-link preproc "#e6f07c"
color-link type "#e6f07c"
color-link type.keyword "#9b7dff"
color-link special "#38dce8"
color-link underlined "underline "
color-link error "#ff6f91"
color-link todo "bold #1c1f25,#e6f07c"
color-link ignore "#6b768c"
color-link selection ",#333842"
color-link statusline "#9aa4b6,#24282f"
color-link statusline.inactive "#6b768c,#24282f"
color-link statusline.suggestions "#c8d2e2,#24282f"
color-link tabbar "#6b768c,#24282f"
color-link tabbar.active "bold #e0e7f2,#1c1f25"
color-link indent-char "#474f5e"
color-link line-number "#6b768c,#1c1f25"
color-link current-line-number "bold #e0e7f2,#1c1f25"
color-link cursor-line ",#24282f"
color-link color-column ",#20242a"
color-link gutter-info "#4fa2ff"
color-link gutter-error "#ff6f91"
color-link gutter-warning "#e6f07c"
color-link diff-added "#5ef0a6"
color-link diff-modified "#4fa2ff"
color-link diff-deleted "#ff6f91"
color-link scrollbar "#6b768c"
color-link divider "#2c3039,#1c1f25"
color-link message "#c8d2e2"
color-link error-message "#ff6f91"
color-link match-brace "bold #e0e7f2,#333842"
color-link hlsearch "#e0e7f2,#555a3d"
color-link tab-error ",#3e2b35"
color-link trailingws ",#3e2b35"
