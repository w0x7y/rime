# Rime Abyss: The coldest take, on a darker background: no yellow or orange anywhere, with rose as the only warm accent.
# https://github.com/w0x7y/rime
color-link default "#c2cde0,#15171c"
color-link comment "italic #6b768c"
color-link identifier "#6b9cf4"
color-link identifier.class "#6b9cf4"
color-link identifier.macro "#4fb4dc"
color-link identifier.var "#c2cde0"
color-link constant "#d4aaff"
color-link constant.bool "#d4aaff"
color-link constant.number "#d4aaff"
color-link constant.specialChar "#4fb4dc"
color-link constant.string "#6fd0a8"
color-link constant.string.url "underline #6b9cf4"
color-link statement "#937ff2"
color-link symbol "#9aa4b6"
color-link symbol.operator "#9aa4b6"
color-link symbol.brackets "#7182a8"
color-link symbol.tag "#e8879f"
color-link preproc "#9cf0dc"
color-link type "#9cf0dc"
color-link type.keyword "#937ff2"
color-link special "#4fb4dc"
color-link underlined "underline "
color-link error "#e8879f"
color-link todo "bold #15171c,#9cf0dc"
color-link ignore "#6b768c"
color-link selection ",#2c3039"
color-link statusline "#9aa4b6,#1d2026"
color-link statusline.inactive "#6b768c,#1d2026"
color-link statusline.suggestions "#c2cde0,#1d2026"
color-link tabbar "#6b768c,#1d2026"
color-link tabbar.active "bold #dde5f2,#15171c"
color-link indent-char "#444b5a"
color-link line-number "#6b768c,#15171c"
color-link current-line-number "bold #dde5f2,#15171c"
color-link cursor-line ",#1d2026"
color-link color-column ",#191c21"
color-link gutter-info "#6b9cf4"
color-link gutter-error "#e8879f"
color-link gutter-warning "#9cf0dc"
color-link diff-added "#6fd0a8"
color-link diff-modified "#6b9cf4"
color-link diff-deleted "#e8879f"
color-link scrollbar "#6b768c"
color-link divider "#252830,#15171c"
color-link message "#c2cde0"
color-link error-message "#e8879f"
color-link match-brace "bold #dde5f2,#2c3039"
color-link hlsearch "#dde5f2,#3b5452"
color-link tab-error ",#352830"
color-link trailingws ",#352830"
