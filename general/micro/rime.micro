# Rime: Soft and muted pastels for long sessions.
# https://github.com/w0x7y/rime
color-link default "#c3ccd9,#23272e"
color-link comment "italic #6b768c"
color-link identifier "#7aa4e4"
color-link identifier.class "#7aa4e4"
color-link identifier.macro "#7cc4d0"
color-link identifier.var "#c3ccd9"
color-link constant "#e8a8cc"
color-link constant.bool "#e8a8cc"
color-link constant.number "#e8a8cc"
color-link constant.specialChar "#7cc4d0"
color-link constant.string "#9ad8ac"
color-link constant.string.url "underline #7aa4e4"
color-link statement "#bb98d6"
color-link symbol "#9aa4b6"
color-link symbol.operator "#9aa4b6"
color-link symbol.brackets "#7987a1"
color-link symbol.tag "#d98a9c"
color-link preproc "#e4d098"
color-link type "#e4d098"
color-link type.keyword "#bb98d6"
color-link special "#7cc4d0"
color-link underlined "underline "
color-link error "#d98a9c"
color-link todo "bold #23272e,#e4d098"
color-link ignore "#6b768c"
color-link selection ",#3a404b"
color-link statusline "#9aa4b6,#2b3038"
color-link statusline.inactive "#6b768c,#2b3038"
color-link statusline.suggestions "#c3ccd9,#2b3038"
color-link tabbar "#6b768c,#2b3038"
color-link tabbar.active "bold #dce2eb,#23272e"
color-link indent-char "#4b5262"
color-link line-number "#6b768c,#23272e"
color-link current-line-number "bold #dce2eb,#23272e"
color-link cursor-line ",#2b3038"
color-link color-column ",#272c33"
color-link gutter-info "#7aa4e4"
color-link gutter-error "#d98a9c"
color-link gutter-warning "#e4d098"
color-link diff-added "#9ad8ac"
color-link diff-modified "#7aa4e4"
color-link diff-deleted "#d98a9c"
color-link scrollbar "#6b768c"
color-link divider "#333842,#23272e"
color-link message "#c3ccd9"
color-link error-message "#d98a9c"
color-link match-brace "bold #dce2eb,#3a404b"
color-link hlsearch "#dce2eb,#59564c"
color-link tab-error ",#3e363f"
color-link trailingws ",#3e363f"
